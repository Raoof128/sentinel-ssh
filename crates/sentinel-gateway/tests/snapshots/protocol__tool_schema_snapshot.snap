---
source: crates/sentinel-gateway/tests/protocol.rs
expression: v
---
[
  {
    "description": "Read a byte range (<=64 KiB) of an artefact you own, such as a download or a truncated result.",
    "inputSchema": {
      "$defs": {
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        },
        "Encoding": {
          "enum": [
            "utf8",
            "base64"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ],
          "description": "utf8 (default) or base64."
        },
        "length": {
          "description": "1-65536 bytes, default 4096.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Byte offset, default 0.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id"
      ],
      "type": "object"
    },
    "name": "ssh_artifact_read",
    "outputSchema": {
      "$defs": {
        "ArtifactOrigin": {
          "oneOf": [
            {
              "properties": {
                "host_id": {
                  "type": "string"
                },
                "kind": {
                  "const": "remote_file",
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "root": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "host_id",
                "root",
                "path"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "tool_result",
                  "type": "string"
                },
                "operation_id": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "operation_id"
              ],
              "type": "object"
            }
          ]
        },
        "ArtifactReadData": {
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRecord"
            },
            "bytes_returned": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "content": {
              "type": "string"
            },
            "content_trust": {
              "type": "string"
            },
            "encoding": {
              "$ref": "#/$defs/Encoding"
            },
            "eof": {
              "type": "boolean"
            },
            "offset": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "artifact",
            "offset",
            "bytes_returned",
            "eof",
            "encoding",
            "content",
            "content_trust"
          ],
          "type": "object"
        },
        "ArtifactRecord": {
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "content_kind": {
              "$ref": "#/$defs/ContentKind"
            },
            "created_at": {
              "format": "date-time",
              "type": "string"
            },
            "expires_at": {
              "format": "date-time",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "origin": {
              "$ref": "#/$defs/ArtifactOrigin"
            },
            "owner": {
              "type": "string"
            },
            "sha256": {
              "description": "Lowercase hex SHA-256 of the stored bytes.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "owner",
            "origin",
            "bytes",
            "sha256",
            "content_kind",
            "created_at",
            "expires_at"
          ],
          "type": "object"
        },
        "ContentKind": {
          "enum": [
            "utf8_text",
            "binary",
            "json"
          ],
          "type": "string"
        },
        "Encoding": {
          "enum": [
            "utf8",
            "base64"
          ],
          "type": "string"
        },
        "ErrorCode": {
          "enum": [
            "HOST_KEY_CHANGED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "STALE_PLAN",
            "CAPABILITY_UNSUPPORTED",
            "OUTCOME_UNKNOWN",
            "BUDGET_EXCEEDED",
            "RESUME_UNVERIFIABLE",
            "DESTINATION_EXISTS",
            "DIGEST_MISMATCH",
            "SYNC_CONFLICT",
            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
            "TRANSFER_TIMEOUT_TOTAL",
            "TRANSFER_PARTIAL",
            "EXPORT_NOT_ALLOWED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "TIMEOUT",
            "CONNECTION_FAILED",
            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "required": [
            "kind",
            "source",
            "observed_at"
          ],
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Who observed a fact. Observer-mode evidence comes from a gateway-issued command over the SSH account, not from a host-side broker.",
          "enum": [
            "observer",
            "broker"
          ],
          "type": "string"
        },
        "Outcome": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "RetryStrategy": {
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "never",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "reconcile",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "replan",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "narrow_request",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "strategy": {
                  "const": "retry_after",
                  "type": "string"
                }
              },
              "required": [
                "strategy",
                "seconds"
              ],
              "type": "object"
            }
          ]
        },
        "SentinelError": {
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": {
              "additionalProperties": true,
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/RetryStrategy"
            }
          },
          "required": [
            "code",
            "message",
            "retry"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "artifact_id": {
          "description": "Holds the complete envelope when truncated; read it with `ssh_artifact_read`.",
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReadData"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` when the result was truncated to an artefact or the call failed."
        },
        "data_preview": {
          "description": "Start of the pretty-printed data when truncated.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SentinelError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the outcome is failed, cancelled or outcome_unknown."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "retry": {
          "$ref": "#/$defs/RetryStrategy"
        },
        "schema_version": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "observed_at",
        "truncated",
        "evidence",
        "retry",
        "warnings"
      ],
      "type": "object"
    }
  },
  {
    "description": "Run up to 16 typed read tools in one call; each item is separately authorised and reports its own success or error.",
    "inputSchema": {
      "$defs": {
        "BatchItem": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Caller-chosen id, unique in the batch: ^[A-Za-z0-9_-]{1,32}$.",
              "type": "string"
            },
            "params": {
              "default": null,
              "description": "That tool's parameters."
            },
            "tool": {
              "description": "One of the batchable read tools.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "tool"
          ],
          "type": "object"
        },
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "description": "1-16 items.",
          "items": {
            "$ref": "#/$defs/BatchItem"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "name": "ssh_batch_inspect",
    "outputSchema": {
      "$defs": {
        "BatchInspectData": {
          "properties": {
            "error_count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "items": {
              "items": {
                "$ref": "#/$defs/BatchItemResult"
              },
              "type": "array"
            },
            "ok_count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "items",
            "ok_count",
            "error_count"
          ],
          "type": "object"
        },
        "BatchItemResult": {
          "oneOf": [
            {
              "properties": {
                "id": {
                  "type": "string"
                },
                "result": true,
                "status": {
                  "const": "ok",
                  "type": "string"
                }
              },
              "required": [
                "status",
                "id",
                "result"
              ],
              "type": "object"
            },
            {
              "properties": {
                "error": {
                  "$ref": "#/$defs/SentinelError"
                },
                "id": {
                  "type": "string"
                },
                "status": {
                  "const": "error",
                  "type": "string"
                }
              },
              "required": [
                "status",
                "id",
                "error"
              ],
              "type": "object"
            }
          ]
        },
        "ErrorCode": {
          "enum": [
            "HOST_KEY_CHANGED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "STALE_PLAN",
            "CAPABILITY_UNSUPPORTED",
            "OUTCOME_UNKNOWN",
            "BUDGET_EXCEEDED",
            "RESUME_UNVERIFIABLE",
            "DESTINATION_EXISTS",
            "DIGEST_MISMATCH",
            "SYNC_CONFLICT",
            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
