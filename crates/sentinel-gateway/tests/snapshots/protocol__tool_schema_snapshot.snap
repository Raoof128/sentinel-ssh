    "name": "ssh_operation_get",
    "outputSchema": {
      "$defs": {
        "Effect": {
          "oneOf": [
            {
              "const": "read",
              "description": "No intended remote application mutation.",
              "type": "string"
            },
            {
              "const": "export",
              "description": "Moves confidential information to a new trust boundary.",
              "type": "string"
            },
            {
              "const": "control",
              "description": "Changes gateway or job state, or stops an owned operation.",
              "type": "string"
            },
            {
              "const": "plan",
              "description": "Creates a proposal.",
              "type": "string"
            },
            {
              "const": "stage",
              "description": "Writes isolated staging storage.",
              "type": "string"
            },
            {
              "const": "change",
              "description": "Can modify an approved remote resource.",
              "type": "string"
            }
          ]
        },
        "ErrorCode": {
          "enum": [
            "HOST_KEY_CHANGED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "STALE_PLAN",
            "CAPABILITY_UNSUPPORTED",
            "OUTCOME_UNKNOWN",
            "BUDGET_EXCEEDED",
            "RESUME_UNVERIFIABLE",
            "DESTINATION_EXISTS",
            "DIGEST_MISMATCH",
            "SYNC_CONFLICT",
            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
            "TRANSFER_TIMEOUT_TOTAL",
            "TRANSFER_PARTIAL",
            "EXPORT_NOT_ALLOWED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "TIMEOUT",
            "CONNECTION_FAILED",
            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "required": [
            "kind",
            "source",
            "observed_at"
          ],
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Who observed a fact. Observer-mode evidence comes from a gateway-issued command over the SSH account, not from a host-side broker.",
          "enum": [
            "observer",
            "broker"
          ],
          "type": "string"
        },
        "OperationRecord": {
          "properties": {
            "created_at": {
              "format": "date-time",
              "type": "string"
            },
            "effect": {
              "$ref": "#/$defs/Effect"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SentinelError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "finished_at": {
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "host_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "principal": {
              "type": "string"
            },
            "remote_termination": {
              "$ref": "#/$defs/RemoteTermination"
            },
            "result_artifact": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "$ref": "#/$defs/OperationState"
            },
            "tool": {
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "id",
            "principal",
            "tool",
            "effect",
            "state",
            "created_at",
            "updated_at",
            "remote_termination"
          ],
          "type": "object"
        },
        "OperationState": {
          "enum": [
            "received",
            "authorised",
            "rejected",
            "awaiting_approval",
            "queued",
            "running",
            "verifying",
            "succeeded",
            "failed",
            "cancel_requested",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "Outcome": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "RemoteTermination": {
          "description": "Whether a stopped operation is known to have stopped on the remote host (spec §10.3).",
          "enum": [
            "confirmed",
            "unconfirmed",
            "unknown",
            "not_applicable"
          ],
          "type": "string"
        },
        "RetryStrategy": {
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "never",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "reconcile",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "replan",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "narrow_request",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "strategy": {
                  "const": "retry_after",
                  "type": "string"
                }
              },
              "required": [
                "strategy",
                "seconds"
              ],
              "type": "object"
            }
          ]
        },
        "SentinelError": {
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": {
              "additionalProperties": true,
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/RetryStrategy"
            }
          },
          "required": [
            "code",
            "message",
            "retry"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "artifact_id": {
          "description": "Holds the complete envelope when truncated; read it with `ssh_artifact_read`.",
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` when the result was truncated to an artefact or the call failed."
        },
        "data_preview": {
          "description": "Start of the pretty-printed data when truncated.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SentinelError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the outcome is failed, cancelled or outcome_unknown."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "retry": {
          "$ref": "#/$defs/RetryStrategy"
        },
        "schema_version": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "observed_at",
        "truncated",
        "evidence",
        "retry",
        "warnings"
      ],
      "type": "object"
    }
  },
  {
    "description": "List process summaries (pid, user, CPU, memory, elapsed, command) with command-line secrets redacted; at most 200.",
