  {
    "description": "Run an operator-registered health check from the host (HTTP status or service active). Never an arbitrary URL or code.",
    "inputSchema": {
      "$defs": {
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "description": "A health check id from `ssh_hosts_list`.",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_id": {
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "check_id"
      ],
      "type": "object"
    },
    "name": "ssh_health_check",
    "outputSchema": {
      "$defs": {
        "ErrorCode": {
          "enum": [
            "HOST_KEY_CHANGED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "STALE_PLAN",
            "CAPABILITY_UNSUPPORTED",
            "OUTCOME_UNKNOWN",
            "BUDGET_EXCEEDED",
            "RESUME_UNVERIFIABLE",
            "DESTINATION_EXISTS",
            "DIGEST_MISMATCH",
            "SYNC_CONFLICT",
            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
            "TRANSFER_TIMEOUT_TOTAL",
            "TRANSFER_PARTIAL",
            "EXPORT_NOT_ALLOWED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "TIMEOUT",
            "CONNECTION_FAILED",
            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "required": [
            "kind",
            "source",
            "observed_at"
          ],
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Who observed a fact. Observer-mode evidence comes from a gateway-issued command over the SSH account, not from a host-side broker.",
          "enum": [
            "observer",
            "broker"
          ],
          "type": "string"
        },
        "HealthCheckConfig": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "expect_status": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "kind": {
                  "const": "http",
                  "type": "string"
                },
                "timeout_secs": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "url",
                "expect_status",
                "timeout_secs"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "service_active",
                  "type": "string"
                },
                "service": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "service"
              ],
              "type": "object"
            }
          ]
        },
        "HealthResult": {
          "properties": {
            "check_id": {
              "type": "string"
            },
            "definition": {
              "$ref": "#/$defs/HealthCheckConfig",
              "description": "The registered definition, so another observer can repeat the check (spec §6.3)."
            },
            "kind": {
              "type": "string"
            },
            "observation": true,
            "passing": {
              "type": "boolean"
            }
          },
          "required": [
            "check_id",
            "kind",
            "passing",
            "observation",
            "definition"
          ],
          "type": "object"
        },
        "Outcome": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "RetryStrategy": {
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "never",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "reconcile",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "replan",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "narrow_request",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "strategy": {
                  "const": "retry_after",
                  "type": "string"
                }
              },
              "required": [
                "strategy",
                "seconds"
              ],
              "type": "object"
            }
          ]
        },
        "SentinelError": {
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": {
              "additionalProperties": true,
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/RetryStrategy"
            }
          },
          "required": [
            "code",
            "message",
            "retry"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "artifact_id": {
          "description": "Holds the complete envelope when truncated; read it with `ssh_artifact_read`.",
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthResult"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` when the result was truncated to an artefact or the call failed."
        },
        "data_preview": {
          "description": "Start of the pretty-printed data when truncated.",
          "type": [
