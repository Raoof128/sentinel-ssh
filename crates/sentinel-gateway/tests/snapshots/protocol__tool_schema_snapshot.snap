            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
            "TRANSFER_TIMEOUT_TOTAL",
            "TRANSFER_PARTIAL",
            "EXPORT_NOT_ALLOWED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "TIMEOUT",
            "CONNECTION_FAILED",
            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
