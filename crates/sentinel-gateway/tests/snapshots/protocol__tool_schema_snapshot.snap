              },
              "type": "array"
            },
            "entries_truncated": {
              "type": "boolean"
            },
            "filesystem": {
              "$ref": "#/$defs/FilesystemUsage"
            },
            "path": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "total_bytes": {
              "description": "Usage of the requested path itself.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "root",
