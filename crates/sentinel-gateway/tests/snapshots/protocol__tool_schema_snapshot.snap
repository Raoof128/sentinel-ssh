            }
          ],
          "description": "Present when the outcome is failed, cancelled or outcome_unknown."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
