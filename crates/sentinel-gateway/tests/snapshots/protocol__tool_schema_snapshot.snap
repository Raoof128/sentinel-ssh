  {
    "description": "Fixed-string search of a registered log source, at most 200 matches, optionally only the last N bytes.",
    "inputSchema": {
      "$defs": {
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        },
        "PatternMode": {
          "oneOf": [
            {
              "enum": [
                "fixed"
              ],
              "type": "string"
            },
            {
              "const": "regex",
              "description": "Not available in v0.1.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_id": {
          "type": "string"
        },
        "last_bytes": {
          "description": "Search only the final N bytes (at most 64 MiB). Line numbers are then relative to that window.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_matches": {
          "description": "1-200, default 50.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pattern": {
          "description": "Fixed string, 1-256 characters, no control characters.",
          "type": "string"
        },
        "pattern_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatternMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "description": "A log source id from `ssh_hosts_list`.",
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "source_id",
        "pattern"
      ],
      "type": "object"
    },
