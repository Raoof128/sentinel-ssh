            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "required": [
            "kind",
            "source",
            "observed_at"
          ],
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Who observed a fact. Observer-mode evidence comes from a gateway-issued command over the SSH account, not from a host-side broker.",
          "enum": [
            "observer",
            "broker"
          ],
          "type": "string"
        },
        "Outcome": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "RetryStrategy": {
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "never",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "reconcile",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "replan",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
