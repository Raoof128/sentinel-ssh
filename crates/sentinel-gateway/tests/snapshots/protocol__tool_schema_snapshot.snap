          "anyOf": [
            {
              "$ref": "#/$defs/SentinelError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the outcome is failed, cancelled or outcome_unknown."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "retry": {
          "$ref": "#/$defs/RetryStrategy"
        },
        "schema_version": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "observed_at",
        "truncated",
        "evidence",
        "retry",
        "warnings"
      ],
      "type": "object"
    }
  },
  {
    "description": "Download a regular file from an export-permitted root into a private artefact, verified by SHA-256. Bytes never enter model context; returns an artefact handle.",
    "inputSchema": {
      "$defs": {
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_sha256": {
          "description": "Refuse unless the remote file currently has this SHA-256 (64 hex characters).",
          "type": [
            "string",
            "null"
          ]
        },
        "host_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "root": {
          "description": "A root alias with export permission.",
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "root",
        "path"
      ],
      "type": "object"
    },
    "name": "ssh_transfer_download",
    "outputSchema": {
      "$defs": {
        "ArtifactOrigin": {
          "oneOf": [
            {
              "properties": {
                "host_id": {
                  "type": "string"
                },
                "kind": {
                  "const": "remote_file",
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "root": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "host_id",
                "root",
                "path"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "tool_result",
                  "type": "string"
                },
                "operation_id": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "operation_id"
              ],
              "type": "object"
            }
          ]
        },
        "ErrorCode": {
          "enum": [
            "HOST_KEY_CHANGED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "STALE_PLAN",
            "CAPABILITY_UNSUPPORTED",
            "OUTCOME_UNKNOWN",
            "BUDGET_EXCEEDED",
            "RESUME_UNVERIFIABLE",
            "DESTINATION_EXISTS",
            "DIGEST_MISMATCH",
            "SYNC_CONFLICT",
            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
            "TRANSFER_TIMEOUT_TOTAL",
            "TRANSFER_PARTIAL",
            "EXPORT_NOT_ALLOWED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "TIMEOUT",
            "CONNECTION_FAILED",
            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "required": [
            "kind",
            "source",
            "observed_at"
          ],
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Who observed a fact. Observer-mode evidence comes from a gateway-issued command over the SSH account, not from a host-side broker.",
          "enum": [
            "observer",
            "broker"
          ],
          "type": "string"
        },
        "Outcome": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "RetryStrategy": {
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "never",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "reconcile",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "replan",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "narrow_request",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "strategy": {
                  "const": "retry_after",
                  "type": "string"
                }
              },
              "required": [
                "strategy",
                "seconds"
              ],
              "type": "object"
            }
          ]
        },
        "SentinelError": {
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": {
              "additionalProperties": true,
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/RetryStrategy"
            }
          },
          "required": [
            "code",
            "message",
            "retry"
          ],
          "type": "object"
        },
        "TransferDownloadData": {
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "content_trust": {
              "type": "string"
            },
            "expires_at": {
              "format": "date-time",
              "type": "string"
            },
            "next_action": {
              "type": "string"
            },
            "sha256": {
              "description": "Remote and local SHA-256 agree on this value.",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/ArtifactOrigin"
            }
          },
          "required": [
            "artifact_id",
            "bytes",
            "sha256",
            "source",
            "expires_at",
            "next_action",
            "content_trust"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "artifact_id": {
          "description": "Holds the complete envelope when truncated; read it with `ssh_artifact_read`.",
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransferDownloadData"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` when the result was truncated to an artefact or the call failed."
        },
        "data_preview": {
          "description": "Start of the pretty-printed data when truncated.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SentinelError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the outcome is failed, cancelled or outcome_unknown."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "retry": {
          "$ref": "#/$defs/RetryStrategy"
        },
        "schema_version": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "observed_at",
        "truncated",
        "evidence",
        "retry",
        "warnings"
      ],
      "type": "object"
    }
  }
]
