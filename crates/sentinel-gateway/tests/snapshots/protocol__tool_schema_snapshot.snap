  {
    "description": "Describe this gateway's backend, limits, protocol versions and guarantees, including the weaker observer-mode guarantees.",
    "inputSchema": {
      "$defs": {
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_id": {
          "description": "Also describe this host.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "ssh_capabilities_get",
    "outputSchema": {
      "$defs": {
        "BackendCapabilities": {
          "properties": {
            "connection_reuse": {
              "type": "boolean"
            },
            "host_key_pinning": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "remote_termination": {
              "$ref": "#/$defs/RemoteTermination"
            }
          },
          "required": [
            "name",
            "host_key_pinning",
            "remote_termination",
            "connection_reuse"
          ],
          "type": "object"
        },
        "Budgets": {
          "additionalProperties": false,
          "description": "Initial design defaults from spec §11.3. Not proven optimal; adjust through a measured process.",
          "properties": {
            "artifact_retention_hours": {
              "default": 24,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "connect_timeout_secs": {
              "default": 10,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "default_result_bytes": {
              "default": 8192,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_active_operations": {
              "default": 64,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_batch_items": {
              "default": 16,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_pending_operations": {
              "default": 128,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_result_bytes": {
              "default": 65536,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_transfer_bytes": {
              "default": 268435456,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "per_host_reads": {
              "default": 4,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "queue_wait_secs": {
              "default": 5,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "read_timeout_secs": {
              "default": 30,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "transfer_chunk_bytes": {
              "default": 65536,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "transfer_idle_timeout_secs": {
              "default": 30,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "transfer_total_timeout_secs": {
              "default": 600,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "CapabilitiesData": {
          "properties": {
            "backend": {
              "$ref": "#/$defs/BackendCapabilities"
            },
            "gateway_version": {
              "type": "string"
            },
            "guarantees": {
              "$ref": "#/$defs/Guarantees"
            },
            "host": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HostSummary"
                },
                {
                  "type": "null"
                }
              ]
            },
            "limits": {
              "$ref": "#/$defs/Budgets"
            },
            "mode": {
              "type": "string"
            },
            "protocol_versions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "schema_version": {
              "type": "string"
            },
            "tools": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "gateway_version",
            "schema_version",
            "protocol_versions",
            "mode",
            "backend",
            "guarantees",
            "tools",
            "limits"
          ],
          "type": "object"
        },
        "ErrorCode": {
          "enum": [
            "HOST_KEY_CHANGED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "STALE_PLAN",
            "CAPABILITY_UNSUPPORTED",
            "OUTCOME_UNKNOWN",
            "BUDGET_EXCEEDED",
            "RESUME_UNVERIFIABLE",
            "DESTINATION_EXISTS",
            "DIGEST_MISMATCH",
            "SYNC_CONFLICT",
            "ARTIFACT_EXPIRED",
            "SOURCE_CHANGED",
            "DISK_FULL",
            "TRANSFER_TIMEOUT_IDLE",
            "TRANSFER_TIMEOUT_TOTAL",
            "TRANSFER_PARTIAL",
            "EXPORT_NOT_ALLOWED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "TIMEOUT",
            "CONNECTION_FAILED",
            "AUTHENTICATION_FAILED",
            "REMOTE_FAILURE",
            "NOT_UTF8",
            "CONFIG_INVALID",
            "INTERNAL"
          ],
          "type": "string"
        },
        "Evidence": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "required": [
            "kind",
            "source",
            "observed_at"
          ],
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Who observed a fact. Observer-mode evidence comes from a gateway-issued command over the SSH account, not from a host-side broker.",
          "enum": [
            "observer",
            "broker"
          ],
          "type": "string"
        },
        "Guarantees": {
          "properties": {
            "remote_enforcement": {
              "description": "False in observer mode: the SSH account itself is not restricted by the gateway.",
              "type": "boolean"
            },
            "remote_termination": {
              "$ref": "#/$defs/RemoteTermination"
            },
            "statement": {
              "type": "string"
            },
            "symlink_containment": {
              "type": "string"
            }
          },
          "required": [
            "remote_enforcement",
            "remote_termination",
            "statement",
            "symlink_containment"
          ],
          "type": "object"
        },
        "HostSummary": {
          "description": "What an agent may know about a host: ids and registered resource names, never addresses, users or keys.",
          "properties": {
            "environment": {
              "type": "string"
            },
            "export_roots": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "health_checks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "host_id": {
              "type": "string"
            },
            "log_sources": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "roots": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "services": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "host_id",
            "environment",
            "roots",
            "export_roots",
            "services",
            "log_sources",
            "health_checks"
          ],
          "type": "object"
        },
        "Outcome": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "RemoteTermination": {
          "description": "Whether a stopped operation is known to have stopped on the remote host (spec §10.3).",
          "enum": [
            "confirmed",
            "unconfirmed",
            "unknown",
            "not_applicable"
          ],
          "type": "string"
        },
        "RetryStrategy": {
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "never",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "reconcile",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "replan",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "strategy": {
                  "const": "narrow_request",
                  "type": "string"
                }
              },
              "required": [
                "strategy"
              ],
              "type": "object"
            },
            {
              "properties": {
                "seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "strategy": {
                  "const": "retry_after",
                  "type": "string"
                }
              },
              "required": [
                "strategy",
                "seconds"
              ],
              "type": "object"
            }
          ]
        },
        "SentinelError": {
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": {
              "additionalProperties": true,
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/RetryStrategy"
            }
          },
          "required": [
            "code",
            "message",
            "retry"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "artifact_id": {
          "description": "Holds the complete envelope when truncated; read it with `ssh_artifact_read`.",
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilitiesData"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` when the result was truncated to an artefact or the call failed."
        },
        "data_preview": {
          "description": "Start of the pretty-printed data when truncated.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SentinelError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the outcome is failed, cancelled or outcome_unknown."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "retry": {
          "$ref": "#/$defs/RetryStrategy"
        },
        "schema_version": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "observed_at",
        "truncated",
        "evidence",
        "retry",
        "warnings"
      ],
      "type": "object"
    }
  },
  {
    "description": "Report filesystem capacity and directory usage inside a registered root, with depth (<=3) and entry (<=200) caps.",
    "inputSchema": {
      "$defs": {
        "Detail": {
          "oneOf": [
            {
              "const": "concise",
              "description": "Up to 8 KiB inline (default).",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Up to 64 KiB inline.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "depth": {
          "description": "1-3, default 1.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_id": {
          "type": "string"
        },
        "max_entries": {
          "description": "1-200, default 50.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "Path relative to the root; default the root itself.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "description": "A root alias from `ssh_hosts_list`.",
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "root"
      ],
      "type": "object"
    },
    "name": "ssh_disk_usage",
    "outputSchema": {
      "$defs": {
        "DiskEntry": {
          "properties": {
            "bytes": {
              "format": "uint64",
